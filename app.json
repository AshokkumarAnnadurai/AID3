{
  "expo": {
    "name": "AID3",
    "slug": "aid3",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "aid3",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aid3.meetingassistant",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "AID3 requires microphone access to record and transcribe your in-person meetings completely offline on device.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.offlineai.meetingassistant",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "targetSdkVersion": 34,
            "compileSdkVersion": 34,
            "enableProguardInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "whisper.rn",
        {
          "ios": { "enableMetal": true },
          "android": { "enableNNAPI": true }
        }
      ],
      [
        "llama.rn",
        {
          "ios": { "enableMetal": true },
          "android": { "enableOpenCL": true }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
